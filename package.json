{
  "name": "bbcode-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "prebuild": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
